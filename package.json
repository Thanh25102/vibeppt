{
  "name": "@vibeppt/cli",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Local-first Codex workflow and CLI for polished hybrid PowerPoint decks.",
  "type": "module",
  "bin": {
    "vibeppt": "dist/cli.js"
  },
  "files": [
    "dist",
    "presets",
    "templates",
    "studio",
    "scripts",
    "skill",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "sample": "npm run build && node dist/cli.js build examples/northstar/deck.json --out .artifacts/northstar --force",
    "previews": "npm run build && node scripts/render-template-previews.mjs",
    "studio": "npm run build && node dist/cli.js studio"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "playwright": "^1.62.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
