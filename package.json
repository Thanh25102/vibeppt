{
  "name": "@vibeppt/cli",
  "version": "0.4.0-alpha.1",
  "private": true,
  "description": "Local-first Codex workflow and CLI for polished hybrid PowerPoint decks.",
  "author": "Bùi Mạnh Thành",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thanh25102/vibeppt.git"
  },
  "homepage": "https://github.com/Thanh25102/vibeppt#readme",
  "bugs": "https://github.com/Thanh25102/vibeppt/issues",
  "type": "module",
  "bin": {
    "vibeppt": "dist/cli.js"
  },
  "files": [
    "dist",
    "presets",
    "templates",
    "studio",
    "site",
    "scripts",
    "skill",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pack": "npm run build && npm pack",
    "test": "npm run build && node --test test/*.test.mjs",
    "sample": "npm run build && node dist/cli.js build examples/northstar/deck.json --out .artifacts/northstar --force",
    "previews": "npm run build && node scripts/render-template-previews.mjs",
    "studio": "npm run build && node dist/cli.js studio",
    "site:build": "npm run build && node scripts/site.mjs build",
    "site:serve": "node scripts/site.mjs serve",
    "test:site": "npm run site:build && node test/site-browser.mjs",
    "test:visual": "npm run build && node scripts/visual-gate.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "playwright": "^1.62.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
